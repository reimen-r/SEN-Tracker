# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Set it in .env.local (never commit real keys). The app works without it,
# showing a fallback message in the AI analyst modal.
GEMINI_API_KEY=

# APP_URL: The public URL where this app is hosted (self-referential links,
# OAuth callbacks, API endpoints). Optional for local development.
APP_URL=

# TRUST_PROXY: Set to "true" when running behind a reverse proxy / load
# balancer (e.g. Cloud Run) so req.ip reflects the real client IP for rate
# limiting. Defaults to "true"; set to "false" for direct local dev.
TRUST_PROXY=true